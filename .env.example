# GEMINI_API_KEY: Required for Gemma 4 API calls via Google AI Studio / Gemini API.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PROVIDER: Select the active AI engine. Options: 'api' (Google AI Studio Gemma 4) or 'local' (Ollama).
# Default: api
PROVIDER="api"

# GEMMA_MODEL: The exact Gemma 4 model ID on Gemini API.
# Verified Gemma 4 models: 'gemma-4-31b-it' (default) or 'gemma-4-26b-a4b-it'.
GEMMA_MODEL="gemma-4-31b-it"

# OLLAMA_BASE_URL: Local Ollama server endpoint when PROVIDER=local.
# Default: http://localhost:11434
OLLAMA_BASE_URL="http://localhost:11434"

# OLLAMA_MODEL: Local model name pulled in Ollama.
# Default: gemma4:e2b
OLLAMA_MODEL="gemma4:e2b"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
